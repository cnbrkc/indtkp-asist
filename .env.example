# ============================================================================
# Sırlar: GitHub → Settings → Secrets and variables → Actions → "Secrets" sekmesi
# DÖRT secret'ın da dolu olması gerekir; biri boşsa bot açılışta durur ve
# `python bot.py --check` hangi secret'ın eksik olduğunu söyler.
# ============================================================================
API_ID=12345678
API_HASH=your_32_character_api_hash
SESSION_STRING=your_telethon_string_session
# Otomatik yenileme zinciri için: Actions "Read and write" yetkili fine-grained PAT
GH_PAT=github_pat_xxx

# Telegram'dan değiştirilen ayarların (/ayar_set …) config.json'a yazıldıktan sonra
# depoya da işlenmesi için. GitHub Actions'ta GITHUB_TOKEN otomatik gelir (workflow'da
# tanımlı). VM'de çalıştırıyorsan burayı doldur; fine-grained PAT'a
# "Contents: Read and write" izni vermen gerekir. Boşsa değişiklik yalnızca
# o oturumda kalır ve bot bunu sana bildirir.
# GITHUB_TOKEN=github_pat_xxx

# ============================================================================
# Değişkenler (opsiyonel): aynı sayfadaki "Variables" sekmesi.
# config.json ile aynı isimleri taşır ve onun ÜZERİNE yazar.
# ============================================================================
SOURCE_CHATS=@indirimkanali,-1001234567890
DESTINATION=me
INCLUDE_KEYWORDS=çay,kahve,şeker
EXCLUDE_KEYWORDS=çekiliş,hediye
MATCH_MODE=any
COPY_MODE=forward
# Komutların (/status, /restart...) dinleneceği sohbet: "me" veya grup ID'si
CONTROL_CHAT=me
# CONTROL_CHAT bir grup ise zorunlu: komutları kullanabilecek kullanıcı ID'si
ADMIN_USER_ID=1143378073
AUTO_RESTART=true
RESTART_AFTER_MINUTES=330

# Korumalı (noforwards) kanallarda denenecek iletim yollarının sırası.
# forward -> copy -> medyayı indirip yeniden yükle -> sadece metin -> t.me bağlantısı
DELIVERY_MODES=forward,copy,media,text,link
MAX_MEDIA_MB=25

# Bildirim (opsiyonel ama önerilir): mesajları kendi hesabın gönderdiği için
# Telegram bildirim üretmez. @BotFather'dan bot oluştur, gruba ekle, token'ı buraya yaz.
NOTIFY_BOT_TOKEN=123456789:AA...bot_token

# Bağlantılar ve bildirim biçimi.
# LINK_APPENDIX: smart (varsayılan) = gizli hyperlink'ler mesajda tıklanabilir kalır,
#   yalnızca buton/önizleme linkleri metne yazılır. all = tüm gizli linkler de yazılır.
#   off = hiçbiri. (Eski APPEND_LINKS=true, all; false, off anlamına gelir.)
# MESSAGE_LINK: iletinin sonuna "🔗 Mesajı Gör: https://t.me/..." satırı ekle.
# SOURCE_FOOTER: bildirime "Fırsatı Gönderen: <kaynak>" satırı ekle (kaynak adı
#   orijinal mesajın t.me linkini gizler).
# NOTIFY_MEDIA: bildirim botu fotoğraf/videoyu da göndersin.
LINK_APPENDIX=smart
MESSAGE_LINK=true
SOURCE_FOOTER=true
NOTIFY_MEDIA=true
